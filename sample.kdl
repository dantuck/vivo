default-task "backup"

tasks {
    task "backup-main" {description "Sample backup task for development"
        backup {
            repo "/tmp/vivo-dev-repo"
            directory "/tmp/vivo-test-data"
            retention {
                daily 7
                weekly 5
                monthly 12
                yearly 2
            }
remote "rustfs:https://rustfs.cinnamon-trout.ts.net/test-backup"{
credentials "rustfs"
            }
        }
    }
    task "backup" {
        calls "backup-main"
    }
}
